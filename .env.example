# Copia este archivo como .env y completa solo los valores necesarios.
# .env está ignorado por Git y no debe subirse al repositorio.

APP_PORT=3000
APP_TIMEZONE=Europe/Zurich

# Opcional: el token puede guardarse desde ⚙ Configuración → Telegram.
# Si lo defines aquí, tendrá prioridad y la web lo mostrará como
# "gestionado por entorno", sin permitir sustituirlo desde la interfaz.
TELEGRAM_BOT_TOKEN=

# Frecuencia de comprobación de recordatorios (mínimo efectivo: 30 s).
TELEGRAM_POLL_SECONDS=60

# Calendarios externos: intervalo de sincronización automática.
ICAL_SYNC_MINUTES=30

# Tamaño máximo por documento adjunto, en bytes (20 MiB por defecto).
MAX_ATTACHMENT_BYTES=20971520

# Opcional: URL interna del servicio Gastos de comida.
# También puede configurarse desde ⚙ Configuración → Gastos de comida.
GASTOS_COMIDA_URL=
