# Copia este archivo como .env y completa solo los valores necesarios.
# .env está ignorado por Git y no debe subirse al repositorio.

APP_PORT=3000
APP_TIMEZONE=Europe/Zurich

# Opcional: el token puede guardarse desde ⚙ Configuración → Telegram.
# Si lo defines aquí, tendrá prioridad y la web lo mostrará como
# "gestionado por entorno", sin permitir sustituirlo desde la interfaz.
TELEGRAM_BOT_TOKEN=

# Frecuencia de comprobación de recordatorios (mínimo efectivo: 30 s).
TELEGRAM_POLL_SECONDS=60

# Calendarios externos: intervalo de sincronización automática.
ICAL_SYNC_MINUTES=30

# Tamaño máximo por documento adjunto, en bytes (20 MiB por defecto).
MAX_ATTACHMENT_BYTES=20971520

# Integración con Gastos de comida.
# Déjalo vacío hasta hacer la migración única del contenedor actual.
# Después: GASTOS_COMIDA_URL=http://gastos-comida:8000
GASTOS_COMIDA_URL=

# Activa el segundo servicio solo después de apuntar GASTOS_DATA_DIR
# a la base real. Después de la migración puede dejarse permanentemente:
# COMPOSE_PROFILES=gastos

# Puerto web de Gastos en el host. Se mantiene 8000 para conservar el acceso actual.
GASTOS_PORT=8000

# Carpeta del host que contiene el gastos.db REAL.
# Antes de activar el servicio conjunto, ajusta esta ruta a la carpeta usada
# por el contenedor actual de Gastos.
GASTOS_DATA_DIR=./gastos-comida/data

# Protección contra arrancar accidentalmente con una base nueva/vacía.
GASTOS_REQUIRE_EXISTING_DB=1
