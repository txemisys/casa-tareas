# Copia este archivo como .env y completa solo los valores necesarios.
# .env está ignorado por Git y no debe subirse al repositorio.

APP_PORT=3000
APP_TIMEZONE=Europe/Zurich

# Crea el bot con @BotFather y pega aquí el token secreto.
TELEGRAM_BOT_TOKEN=

# Frecuencia de comprobación de recordatorios (mínimo efectivo: 30 s).
TELEGRAM_POLL_SECONDS=60
